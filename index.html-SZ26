Shopshezid
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SHEZID — Premium Streetwear</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #fff;
            color: #111;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* NAVBAR */

        nav {
            height: 75px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 6%;
            border-bottom: 1px solid #eee;
            position: sticky;
            top: 0;
            background: rgba(255,255,255,0.95);
            z-index: 1000;
        }

        .logo {
            font-size: 28px;
            font-weight: 900;
            letter-spacing: 5px;
        }

        .nav-links {
            display: flex;
            gap: 35px;
            list-style: none;
            font-size: 14px;
            font-weight: 600;
        }

        .nav-links a:hover {
            opacity: 0.5;
        }

        .icons {
            display: flex;
            gap: 20px;
            font-size: 20px;
        }

        /* HERO */

        .hero {
            height: 85vh;
            min-height: 550px;
            background:
                linear-gradient(rgba(0,0,0,.25), rgba(0,0,0,.35)),
                url("https://images.unsplash.com/photo-1523398002811-999ca8dec234?auto=format&fit=crop&w=1800&q=80")
                center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
        }

        .hero-content h1 {
            font-size: clamp(55px, 9vw, 120px);
            letter-spacing: 12px;
            font-weight: 900;
        }

        .hero-content p {
            margin: 15px 0 30px;
            font-size: 17px;
            letter-spacing: 3px;
        }

        .shop-btn {
            display: inline-block;
            background: white;
            color: #111;
            padding: 16px 40px;
            font-weight: bold;
            transition: .3s;
        }

        .shop-btn:hover {
            background: #111;
            color: white;
        }

        /* SECTION */

        .section {
            padding: 80px 6%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-title h2 {
            font-size: 34px;
            letter-spacing: 3px;
        }

        .section-title p {
            margin-top: 10px;
            color: #777;
        }

        /* COLLECTIONS */

        .collections {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .collection {
            height: 500px;
            position: relative;
            overflow: hidden;
            background: #eee;
        }

        .collection img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: .5s;
        }

        .collection:hover img {
            transform: scale(1.05);
        }

        .collection-text {
            position: absolute;
            bottom: 35px;
            left: 35px;
            color: white;
        }

        .collection-text h3 {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .collection-text a {
            border-bottom: 1px solid white;
            padding-bottom: 5px;
        }

        /* PRODUCTS */

        .products {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .product {
            cursor: pointer;
        }

        .product-image {
            height: 400px;
            overflow: hidden;
            background: #f3f3f3;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: .4s;
        }

        .product:hover img {
            transform: scale(1.04);
        }

        .product-info {
            padding: 15px 0;
        }

        .product-info h3 {
            font-size: 16px;
            margin-bottom: 7px;
        }

        .price {
            color: #555;
        }

        /* BANNER */

        .banner {
            margin: 30px 6% 80px;
            min-height: 400px;
            background:
                linear-gradient(rgba(0,0,0,.4), rgba(0,0,0,.4)),
                url("https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1800&q=80")
                center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
        }

        .banner h2 {
            font-size: 50px;
            letter-spacing: 5px;
        }

        .banner p {
            margin: 15px 0 25px;
        }

        /* NEWSLETTER */

        .newsletter {
            text-align: center;
            padding: 80px 20px;
            background: #f7f7f7;
        }

        .newsletter h2 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .newsletter p {
            color: #666;
            margin-bottom: 25px;
        }

        .email-box {
            display: flex;
            max-width: 500px;
            margin: auto;
        }

        .email-box input {
            flex: 1;
            padding: 15px;
            border: 1px solid #ccc;
            outline: none;
        }

        .email-box button {
            padding: 15px 25px;
            border: none;
            background: #111;
            color: white;
            cursor: pointer;
        }

        /* FOOTER */

        footer {
            background: #111;
            color: white;
            padding: 60px 6% 25px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 50px;
        }

        .footer-brand h2 {
            letter-spacing: 5px;
            margin-bottom: 15px;
        }

        .footer-brand p {
            color: #aaa;
            max-width: 300px;
            line-height: 1.6;
        }

        footer h3 {
            margin-bottom: 15px;
        }

        footer ul {
            list-style: none;
        }

        footer li {
            color: #aaa;
            margin-bottom: 10px;
        }

        .copyright {
            border-top: 1px solid #333;
            padding-top: 20px;
            text-align: center;
            color: #777;
            font-size: 13px;
        }

        /* MOBILE */

        @media (max-width: 800px) {

            nav {
                padding: 0 5%;
            }

            .nav-links {
                display: none;
            }

            .logo {
                font-size: 23px;
            }

            .hero {
                height: 75vh;
            }

            .hero-content h1 {
                letter-spacing: 7px;
            }

            .collections {
                grid-template-columns: 1fr;
            }

            .collection {
                height: 420px;
            }

            .products {
                grid-template-columns: repeat(2, 1fr);
                gap: 15px;
            }

            .product-image {
                height: 280px;
            }

            .banner h2 {
                font-size: 35px;
            }

            .footer-content {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 500px) {

            .section {
                padding: 60px 5%;
            }

            .products {
                grid-template-columns: 1fr 1fr;
            }

            .product-image {
                height: 230px;
            }

            .email-box {
                flex-direction: column;
                gap: 10px;
            }

            .footer-content {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->

    <nav>
        <div class="logo">SHEZID</div>

        <ul class="nav-links">
            <li><a href="#">MEN</a></li>
            <li><a href="#collections">COLLECTIONS</a></li>
            <li><a href="#t-shirts">T-SHIRT</a></li>
            <li><a href="#hoodies">HOODIES</a></li>
        </ul>

        <div class="icons">
            <span>⌕</span>
            <span>♡</span>
            <span>🛒</span>
        </div>
    </nav>


    <!-- HERO -->

    <section class="hero">

        <div class="hero-content">

            <h1>SHEZID</h1>

            <p>DEFINED BY STYLE</p>

            <a href="#shop" class="shop-btn">
                SHOP NOW
            </a>

        </div>

    </section>


    <!-- COLLECTIONS -->

    <section class="section" id="collections">

        <div class="section-title">
            <h2>SHOP THE COLLECTION</h2>
            <p>Designed for those who stand apart.</p>
        </div>

        <div class="collections">

            <div class="collection">
                <img src="https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=900&q=80">

                <div class="collection-text">
                    <h3>TEES</h3>
                    <a href="#shop">SHOP NOW →</a>
                </div>
            </div>

            <div class="collection">
                <img src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=900&q=80">

                <div class="collection-text">
                    <h3>HOODIES</h3>
                    <a href="#shop">SHOP NOW →</a>
                </div>
            </div>

            <div class="collection">
                <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=80">

                <div class="collection-text">
                    <h3>ESSENTIALS</h3>
                    <a href="#shop">SHOP NOW →</a>
                </div>
            </div>

        </div>

    </section>


    <!-- PRODUCTS -->

    <section class="section" id="shop">

        <div class="section-title">
            <h2>NEW ARRIVALS</h2>
            <p>Our latest pieces.</p>
        </div>

        <div class="products">

            <div class="product">

                <div class="product-image">
                    <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=700&q=80">
                </div>

                <div class="product-info">
                    <h3>Classic Oversized Tee</h3>
                    <p class="price">₹1,499</p>
                </div>

            </div>


            <div class="product">

                <div class="product-image">
                    <img src="https://images.unsplash.com/photo-1503341504253-dff4815485f1?auto=format&fit=crop&w=700&q=80">
                </div>

                <div class="product-info">
                    <h3>Signature Black Tee</h3>
                    <p class="price">₹1,499</p>
                </div>

            </div>


            <div class="product">

                <div class="product-image">
                    <img src="https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=700&q=80">
                </div>

                <div class="product-info">
                    <h3>Essential White Tee</h3>
                    <p class="price">₹1,399</p>
                </div>

            </div>


            <div class="product">

                <div class="product-image">
                    <img src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=700&q=80">
                </div>

                <div class="product-info">
                    <h3>Premium Hoodie</h3>
                    <p class="price">₹2,499</p>
                </div>

            </div>

        </div>

    </section>


    <!-- PROMO BANNER -->

    <section class="banner">

        <div>
            <h2>WEAR YOUR IDENTITY.</h2>
            <p>Premium essentials. Timeless attitude.</p>

            <a href="#shop" class="shop-btn">
                EXPLORE SHEZID
            </a>
        </div>

    </section>


    <!-- NEWSLETTER -->

    <section class="newsletter">

        <h2>JOIN SHEZID</h2>

        <p>
            Get early access to new drops and exclusive collections.
        </p>

        <div class="email-box">

            <input
                type="email"
                placeholder="Enter your email"
            >

            <button>
                JOIN
            </button>

        </div>

    </section>


    <!-- FOOTER -->

    <footer id="about">

        <div class="footer-content">

            <div class="footer-brand">

                <h2>SHEZID</h2>

                <p>
                    Premium streetwear created for
                    individuality, confidence and modern style.
                </p>

            </div>


            <div>

                <h3>SHOP</h3>

                <ul>
                    <li>New Arrivals</li>
                    <li>T-Shirts</li>
                    <li>Hoodies</li>
                    <li>Essentials</li>
                </ul>

            </div>


            <div>

                <h3>HELP</h3>

                <ul>
                    <li>Contact</li>
                    <li>Shipping</li>
                    <li>Returns</li>
                    <li>FAQ</li>
                </ul>

            </div>


            <div>

                <h3>FOLLOW</h3>

                <ul>
                    <li>Instagram</li>
                    <li>Facebook</li>
                    <li>YouTube</li>
                </ul>

            </div>

        </div>


        <div class="copyright">

            © 2026 SHEZID. All Rights Reserved.

        </div>

    </footer>

</body>
</html>
